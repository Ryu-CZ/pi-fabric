{
  "name": "pi-fabric",
  "version": "0.1.0",
  "private": false,
  "description": "Pi extension adapter for Hermes/Icarus Fabric markdown corpus",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke:icarus-interop": "npm run build && node scripts/smoke-icarus-interop.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.2.9",
    "typescript": "^5.8.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
